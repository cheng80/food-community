# Supabase > sesac_org > food-community > Connect / API Keys
# 서버 전용. service_role 키를 사용하지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 예: https://PROJECT.supabase.co/storage/v1/object/public
SUPABASE_STORAGE_URL=
APP_URL=http://localhost:3000

# NCP > Maps > Application (Dynamic Map + Reverse Geocoding)
# 브라우저에 공개되는 지도 식별자. 허용 도메인을 NCP에서 제한하세요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# NCP > NAVER API HUB > Application > 검색 API
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
