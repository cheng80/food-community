# Supabase > sesac_org > food-community > Connect / API Keys
# 서버 전용. service_role 키를 사용하지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 예: https://PROJECT.supabase.co/storage/v1/object/public
SUPABASE_STORAGE_URL=
APP_URL=http://localhost:3000

# NCP > Maps > Application (Dynamic Map + Reverse Geocoding)
# 브라우저에 공개되는 지도 식별자. 허용 도메인을 NCP에서 제한하세요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# NCP > NAVER API HUB > Application > 검색 API
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Day 64: 테스트 채널만 사용. 모든 값은 서버에서 읽습니다.
PORTONE_STORE_ID=
PORTONE_TEST_CHANNEL_KEY=
PORTONE_API_SECRET=
# 결제 기록 전용 서버 키. 공개 Supabase 클라이언트에는 사용하지 않습니다.
SUPABASE_PAYMENT_SERVER_KEY=
